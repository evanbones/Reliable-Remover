{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://github.com/evanbones/Reliable-Remover",
        "sources": "https://github.com/evanbones/Reliable-Remover"
    },
    "license": "${license}",
    "icon": "${mod_id}.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.evandev.reliable_remover.ReliableRemoverMod"
        ],
        "client": [
            "com.evandev.reliable_remover.client.ReliableRemoverModClient"
        ],
        "modmenu": [
            "com.evandev.reliable_remover.compat.ModMenuIntegration"
        ],
        "rrv_client": [
            "com.evandev.reliable_remover.compat.ReliableRemoverRrvPlugin"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": ">26 <27",
        "java": ">=${java_version}",
        "reliable_recipes": ">=1.13.0",
        "yet_another_config_lib_v3": ">=${yacl_version}"
    },
    "suggests": {
        "rrv": "*"
    }
}